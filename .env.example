# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/prisma-config-env-vars

DATABASE_URL="file:./dev.db"

# NextAuth (Auth.js) — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Gmail SMTP — create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""