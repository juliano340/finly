# Desenvolvimento local usa SQLite com prisma/schema.sqlite.prisma.
# Produção usa PostgreSQL com prisma/schema.prisma e uma URL postgresql://.
# Consulte README.md e docs/MIGRATIONS.md antes de executar comandos Prisma.
DATABASE_URL="file:./dev.db"

# NextAuth (Auth.js) — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Login com Google (opcional) — OAuth client em https://console.cloud.google.com/apis/credentials
# Redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gmail SMTP — create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled)
# EMAILS_DISABLED=true impede qualquer envio (util para testes e2e com SMTP configurado)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
