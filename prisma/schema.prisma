generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum FinancialMonthStatus {
  OPEN
  CLOSED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum FixedCostPaymentMethod {
  PIX
  BANK_SLIP
  DEBIT
  CREDIT_CARD
  CASH
}

enum Frequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}

enum IntervalUnit {
  DAYS
  WEEKS
  MONTHS
  YEARS
}

enum EndType {
  NONE
  DATE
  COUNT
}

enum BankAccountType {
  CHECKING
  SAVINGS
  DIGITAL
  CASH
  INVESTMENT
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  plan                 Plan      @default(FREE)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  financialMonths FinancialMonth[]
  cards       Card[]
  cardInvoices CardInvoice[]
  fixedCosts  FixedCost[]
  fixedCostOccurrences FixedCostOccurrence[]
  bankAccounts BankAccount[]
  bankAccountMovements BankAccountMovement[]
  importSessions ImportSession[]
  importedTransactions ImportedTransaction[]
  descriptionMappings DescriptionMapping[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id     String          @id @default(cuid())
  name   String
  icon   String          @default("wallet")
  color  String          @default("#0EA882")
  type   TransactionType @default(EXPENSE)
  userId String

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  fixedCosts   FixedCost[]
  importedTransactions ImportedTransaction[]
  descriptionMappings  DescriptionMapping[]

  @@unique([name, userId])
}

model Transaction {
  id            String          @id @default(cuid())
  amount        Float
  type          TransactionType
  description   String?
  date          DateTime        @default(now())
  categoryId    String
  bankAccountId String?
  userId        String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  category    Category      @relation(fields: [categoryId], references: [id])
  bankAccount BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements   BankAccountMovement[]

  @@index([userId, type, date])
}

model FinancialMonth {
  id        String               @id @default(cuid())
  month     String
  status    FinancialMonthStatus @default(OPEN)
  userId    String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardInvoices         CardInvoice[]
  fixedCostOccurrences FixedCostOccurrence[]

  @@unique([month, userId])
}

model Card {
  id         String   @id @default(cuid())
  name       String
  brand      String?
  color      String   @default("#22C55E")
  closingDay Int?
  dueDay     Int?
  bankAccountId String?
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  invoices   CardInvoice[]
  fixedCosts FixedCost[]

  @@unique([name, userId])
  @@index([userId, name])
}

model BankAccount {
  id             String          @id @default(cuid())
  name           String
  institution    String?
  type           BankAccountType @default(CHECKING)
  color          String          @default("#22C55E")
  initialBalance Float           @default(0)
  overdraftLimit Float           @default(0)
  active         Boolean         @default(true)
  userId         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards       Card[]
  fixedCosts  FixedCost[]
  movements   BankAccountMovement[]
  transactions Transaction[]

  @@unique([name, userId])
  @@index([userId, name])
}

model BankAccountMovement {
  id            String          @id @default(cuid())
  bankAccountId String
  amount        Float
  type          TransactionType
  description   String?
  date          DateTime        @default(now())
  transactionId String?
  userId        String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  bankAccount BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([bankAccountId, userId, date])
}

model CardInvoice {
  id                    String        @id @default(cuid())
  cardId                String
  financialMonthId      String
  month                 String
  dueDate               DateTime
  amount                Float
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?
  paymentMethod         String?
  paymentBankAccountId  String?
  bankAccountMovementId String?
  importSessionId       String?   @unique
  userId                String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  card           Card           @relation(fields: [cardId], references: [id], onDelete: Cascade)
  financialMonth FinancialMonth @relation(fields: [financialMonthId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  importSession  ImportSession? @relation(fields: [importSessionId], references: [id], onDelete: SetNull)

  @@unique([cardId, month, userId])
  @@index([userId, month])
  @@index([userId, status, dueDate])
}

model FixedCost {
  id             String                 @id @default(cuid())
  name           String
  type           TransactionType        @default(EXPENSE)
  defaultAmount  Float
  categoryId     String
  paymentMethod  FixedCostPaymentMethod
  dueDay         Int?
  paidInsideCard Boolean                @default(false)
  cardId         String?
  bankAccountId  String?
  active         Boolean                @default(true)
  startDate      DateTime               @default(now())
  frequency      Frequency              @default(MONTHLY)
  customInterval Int?
  customUnit     IntervalUnit?
  endType        EndType                @default(NONE)
  endDate        DateTime?
  endAfterCount  Int?
  userId         String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category              @relation(fields: [categoryId], references: [id])
  card        Card?                 @relation(fields: [cardId], references: [id], onDelete: SetNull)
  bankAccount BankAccount?          @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  occurrences FixedCostOccurrence[]

  @@unique([name, userId])
  @@index([userId, active])
}

model FixedCostOccurrence {
  id               String        @id @default(cuid())
  fixedCostId      String
  financialMonthId String
  month            String
  dueDate          DateTime?
  amount           Float
  status           PaymentStatus @default(PENDING)
  paidAt           DateTime?
  deletedAt        DateTime?
  userId           String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  fixedCost      FixedCost      @relation(fields: [fixedCostId], references: [id], onDelete: Cascade)
  financialMonth FinancialMonth @relation(fields: [financialMonthId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fixedCostId, dueDate])
  @@index([userId, month])
  @@index([userId, status, month])
  @@index([fixedCostId, month])
}

model Budget {
  id         String @id @default(cuid())
  amount     Float
  month      String
  categoryId String
  userId     String

  category Category @relation(fields: [categoryId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month, userId])
}

model ImportSession {
  id           String   @id @default(cuid())
  fileName     String
  bank         String?
  invoiceTotal Float?
  dueDate      DateTime?
  rawText      String
  userId       String
  createdAt    DateTime @default(now())

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions ImportedTransaction[]
  cardInvoice  CardInvoice?
  descriptionMappings DescriptionMapping[]

  @@index([userId, createdAt])
}

model ImportedTransaction {
  id              String  @id @default(cuid())
  importSessionId String
  cardIdentifier  String?
  date            DateTime?
  description     String
  amount          Float
  type            String?
  rawLine         String
  categoryId      String?
  userId          String
  createdAt       DateTime @default(now())

  importSession ImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)
  category      Category?     @relation(fields: [categoryId], references: [id])
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([importSessionId])
  @@index([userId, categoryId])
}

model DescriptionMapping {
  id              String @id @default(cuid())
  normalizedDesc  String
  categoryId      String
  importSessionId String?
  userId          String
  createdAt       DateTime @default(now())

  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  importSession ImportSession? @relation(fields: [importSessionId], references: [id], onDelete: SetNull)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([normalizedDesc, userId])
  @@index([userId])
}
